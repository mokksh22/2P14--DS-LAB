#include <iostream>
using namespace std;

void reverseArray(char arr[], int last) {
    int i = 0, j = last;
    while (i < j) {
        swap(arr[i], arr[j]);
        i++, j--;
    }
}

int main() {
    char arr[100];
    int top = -1;
    string input;

    cout << "Enter a string: ";
    cin >> input;

    for (char c : input) 
        arr[++top] = c;

    reverseArray(arr, top);

    cout << "Reversed: ";
    for (int i = 0; i <= top; i++) 
        cout << arr[i];
}


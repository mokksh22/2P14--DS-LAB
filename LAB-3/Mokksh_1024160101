#include <iostream>
#include <cctype>
using namespace std;

#define SIZE 100

struct CharStack {
    char arr[SIZE];
    int top = -1;
    void push(char c){ if(top < SIZE-1) arr[++top] = c; }
    char pop(){ return (top >= 0) ? arr[top--] : '\0'; }
    char peek(){ return (top >= 0) ? arr[top] : '\0'; }
    bool empty(){ return top == -1; }
};

int precedence(char c) {
    if(c == '^') return 3;
    if(c == '*' || c == '/') return 2;
    if(c == '+' || c == '-') return 1;
    return -1;
}

bool isRightAssoc(char c) {
    return c == '^';
}

string infixToPostfix(string exp) {
    CharStack st;
    string res = "";
    for(char c : exp) {
        if(isalnum(c)) res += c;
        else if(c == '(') st.push(c);
        else if(c == ')') {
            while(!st.empty() && st.peek() != '(')
                res += st.pop();
            st.pop(); 
        } else {
            while(!st.empty() && ((precedence(st.peek()) > precedence(c)) ||
                  (precedence(st.peek()) == precedence(c) && !isRightAssoc(c))) && st.peek() != '(')
                res += st.pop();
            st.push(c);
        }
    }
    while(!st.empty()) res += st.pop();
    return res;
}

int main() {
    string exp;
    cin >> exp;
    cout << infixToPostfix(exp);
}


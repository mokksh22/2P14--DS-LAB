#include <iostream>
#include <sstream>
using namespace std;

#define MAX 100

struct IntStack {
    int arr[MAX];
    int top = -1;
    void push(int val){ if(top < MAX-1) arr[++top] = val; }
    int pop(){ return (top >= 0) ? arr[top--] : 0; }
};

int evalPostfix(string expr) {
    IntStack st;
    string token;
    stringstream ss(expr);

    while(ss >> token) {
        if(isdigit(token[0])) {
            st.push(stoi(token));
        } else {
            int b = st.pop();
            int a = st.pop();
            switch(token[0]) {
                case '+': st.push(a+b); break;
                case '-': st.push(a-b); break;
                case '*': st.push(a*b); break;
                case '/': st.push(a/b); break;
            }
        }
    }
    return st.pop();
}

int main() {
    string postfix;
    getline(cin, postfix);
    cout << evalPostfix(postfix);
}

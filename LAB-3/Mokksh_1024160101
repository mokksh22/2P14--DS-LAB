// Q1.
#include <iostream>
using namespace std;

class MyStack {
private:
    static const int CAPACITY = 100;
    int elements[CAPACITY];
    int topIndex;

public:
    MyStack() {
        topIndex = -1;
    }

    void push(int val) {
        if (isFull()) {
            cout << "Stack Overflow: Cannot insert " << val << endl;
            return;
        }
        elements[++topIndex] = val;
        cout << val << " pushed successfully.\n";
    }

    void pop() {
        if (isEmpty()) {
            cout << "Stack Underflow: Nothing to remove.\n";
            return;
        }
        cout << "Popped: " << elements[topIndex--] << endl;
    }

    bool isEmpty() {
        return topIndex == -1;
    }

    bool isFull() {
        return topIndex == CAPACITY - 1;
    }

    void showStack() {
        if (isEmpty()) {
            cout << "Stack is empty.\n";
            return;
        }
        cout << "Stack (top → bottom): ";
        for (int i = topIndex; i >= 0; i--)
            cout << elements[i] << " ";
        cout << endl;
    }

    void topElement() {
        if (isEmpty()) {
            cout << "No element on top.\n";
            return;
        }
        cout << "Top element = " << elements[topIndex] << endl;
    }
};

int main() {
    MyStack st;
    int option, val;

    while (true) {
        cout << "\n*** Stack Operations ***\n";
        cout << "1. Push\n2. Pop\n3. Is Empty?\n4. Is Full?\n5. Display\n6. Peek\n7. Exit\n";
        cout << "Choose: ";
        cin >> option;

        switch (option) {
            case 1:
                cout << "Enter value: ";
                cin >> val;
                st.push(val);
                break;
            case 2:
                st.pop();
                break;
            case 3:
                cout << (st.isEmpty() ? "Yes, empty.\n" : "Not empty.\n");
                break;
            case 4:
                cout << (st.isFull() ? "Yes, full.\n" : "Not full.\n");
                break;
            case 5:
                st.showStack();
                break;
            case 6:
                st.topElement();
                break;
            case 7:
                cout << "Exiting...\n";
                return 0;
            default:
                cout << "Invalid choice!\n";
        }
    }
}


#include <iostream>
using namespace std;

int main() {
    char stk[100];
    int t = -1;
    string expr;

    cout << "Enter expression: ";
    cin >> expr;

    for (char c : expr) {
        if (c == '(') {
            stk[++t] = c; // push
        } else if (c == ')') {
            if (t == -1) {
                cout << "Unbalanced Expression\n";
                return 0;
            }
            t--; // pop
        }
    }

    if (t == -1)
        cout << "Balanced Expression\n";
    else
        cout << "Unbalanced Expression\n";
}

